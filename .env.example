# ============================================================================
#  Magdalene Medza — environment variables
#  Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ============================================================================

# ── Database (Postgres on Neon, see DATABASE.md) ────────────────────────────
# DATABASE_URL = the POOLED connection string (host contains "-pooler").
# DIRECT_URL   = the DIRECT (unpooled) connection string, used for schema sync.
DATABASE_URL="postgresql://user:pass@HOST-pooler/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@HOST/db?sslmode=require"

# ── File uploads (Vercel Blob) ──────────────────────────────────────────────
# Create a Blob store in Vercel → Storage; this token is added automatically.
# If unset (local dev), uploads fall back to ./public/uploads.
BLOB_READ_WRITE_TOKEN=""

# ── Auth (CRITICAL) ─────────────────────────────────────────────────────────
# Secret used to sign the admin session JWT. MUST be long and random.
# A weak/missing secret lets anyone forge an admin login (the app refuses to
# start in production if this is shorter than 32 characters).
# Generate one with:   openssl rand -base64 48
AUTH_SECRET="change-me-run-openssl-rand-base64-48"

# ── Admin account (used only when seeding) ──────────────────────────────────
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="use-a-strong-passphrase"

# ── Business details (used when seeding the database) ───────────────────────
SALON_NAME="Magdalene Medza"
SALON_LOCATION="Your studio address"
WHATSAPP_NUMBER="+254700000000"
OWNER_EMAIL="owner@example.com"

# ── Booking email (Web3Forms) ───────────────────────────────────────────────
# Web3Forms' free plan only accepts submissions from the browser, so the email
# is sent client side and the key is exposed to the client by design (it can
# only deliver mail to your own inbox, never read anything).
WEB3FORMS_ACCESS_KEY=""
NEXT_PUBLIC_WEB3FORMS_KEY=""
NEXT_PUBLIC_OWNER_EMAIL="owner@example.com"

# ── Footer credit ───────────────────────────────────────────────────────────
DEV_WHATSAPP="+254700000000"

# ── Production only (optional) ──────────────────────────────────────────────
# Comma separated list of origins allowed to call the API (CORS). Leave unset
# to keep the API same origin only (recommended).
# ALLOWED_ORIGINS="https://your-domain.com"

# ── Site URL ────────────────────────────────────────────────────────────────
# Your public address (no trailing slash). Used for SEO links and as the return
# address after a card payment.
NEXT_PUBLIC_SITE_URL="https://hairbymedza.vercel.app"

# ── Salon timezone ──────────────────────────────────────────────────────────
# Servers (e.g. Vercel) run in UTC. All "today" / "now" logic uses this zone.
SALON_TIMEZONE="Africa/Nairobi"

# ── Payments: IntaSend (recommended) ────────────────────────────────────────
# M-Pesa prompt without your own Paybill/Till. Keys from IntaSend dashboard →
# Settings → API Keys (test keys contain "_test_"). Webhook URL to set there:
# <NEXT_PUBLIC_SITE_URL>/api/payments/intasend/webhook with this challenge text.
# If these are set, IntaSend is used instead of Paystack. See PAYMENTS_SETUP.md.
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
INTASEND_WEBHOOK_CHALLENGE=""

# ── Payments: Paystack (alternative) ─────────────────────────────────────────────────────
# Secret key from Paystack → Settings → API Keys & Webhooks. Use sk_test_…
# first (no real money), then sk_live_… once the account is activated. Leave
# empty to switch online payments off (clients then see the manual option).
# Webhook URL to set in Paystack: <NEXT_PUBLIC_SITE_URL>/api/payments/paystack/webhook
# See PAYMENTS_SETUP.md.
PAYSTACK_SECRET_KEY=""

# Salon M-Pesa number for receiving money (shown for manual deposits; used
# when seeding a new database).
MPESA_NUMBER="0701508259"
